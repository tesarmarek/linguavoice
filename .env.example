# =============================================================================
# LinguaVoice Environment Variables
# Copy this file to .env and fill in actual values.
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
# Which LLM backend to use: "azure-openai" or "anthropic"
LLM_PROVIDER=azure-openai

# --- Azure OpenAI ------------------------------------------------------------
# Required when LLM_PROVIDER=azure-openai
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Anthropic Claude --------------------------------------------------------
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- ElevenLabs (Text-to-Speech) ---------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- OpenAI (platform.openai.com) --------------------------------------------
# Required when LLM_PROVIDER=openai — also used for TTS and image fallback
OPENAI_API_KEY=your-openai-api-key

# --- Image Generation --------------------------------------------------------
# DEFAULT: Together.ai FLUX (free tier available)
# Register free at together.ai → API Keys
TOGETHER_API_KEY=your-together-api-key
TOGETHER_IMAGE_MODEL=google/flash-image-3.1

# EXPERIMENTAL: ElevenLabs image beta (uses ELEVENLABS_API_KEY above)
# Set to true to use ElevenLabs instead of Together.ai
ELEVENLABS_IMAGE_ENABLED=false
ELEVENLABS_IMAGE_MODEL=flux-kontext

# FALLBACK: OpenAI DALL-E (used when Together.ai and ElevenLabs both fail)
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_QUALITY=standard

# --- Feature Flags -----------------------------------------------------------
ENABLE_TTS=true
ENABLE_IMAGE=true
ENABLE_SCENARIOS=true

# --- Application -------------------------------------------------------------
DATA_DIR=./data
DEBUG=false
PORT=3000
